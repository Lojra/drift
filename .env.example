# DRIFT Configuration (Optional)
# The application functions 100% out-of-the-box with NO API keys required
# using MusicBrainz, Cover Art Archive, and iTunes Search API.

# Optional: Gemini API key for dynamic AI lateral curation
# VITE_GEMINI_API_KEY=AIzaSy...

# Optional: Spotify API credentials for direct album URI resolution (otherwise uses deep-search links)
# VITE_SPOTIFY_CLIENT_ID=
# VITE_SPOTIFY_CLIENT_SECRET=
